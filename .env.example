# ============================================================================
# Organic Social OS — environment configuration
# Copy to `.env` (local) or set these in Vercel / the worker host.
# NEVER put real secrets in this file. It is committed; real values are not.
# A full explanation of each variable is in docs/ENVIRONMENT.md.
# ============================================================================

# ----------------------------------------------------------------------------
# Database — managed PostgreSQL (Vercel Postgres / Neon / Supabase / RDS).
# DATABASE_URL : pooled connection used by the app + worker at runtime.
# DIRECT_URL   : direct (non-pooled) connection used by `prisma migrate deploy`.
#                With a non-pooling provider, set it to the same value.
# Local dev (docker compose up -d) uses the credentials in docker-compose.yml:
#   postgresql://osos:osos_dev_pw@localhost:5432/osos?schema=public
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public&sslmode=require"

# ----------------------------------------------------------------------------
# App
# APP_BASE_URL : public HTTPS origin of THIS deployment (no trailing slash).
#                Used to build the OAuth redirect URI — must match Meta exactly.
#                e.g. https://organic-social-os.vercel.app
# ----------------------------------------------------------------------------
APP_NAME="Organic Social OS"
NODE_ENV="production"
APP_BASE_URL="https://your-staging-domain.vercel.app"

# ----------------------------------------------------------------------------
# Secrets used to protect credentials at rest and OAuth state.
# APP_ENCRYPTION_KEY : 32 bytes as 64 hex chars. Generate: openssl rand -hex 32
#                      Encrypts stored Instagram tokens (AES-256-GCM).
# OAUTH_STATE_SECRET : HMAC secret for the OAuth `state` token (CSRF). Any long
#                      random string. Falls back to APP_ENCRYPTION_KEY if unset.
# ----------------------------------------------------------------------------
APP_ENCRYPTION_KEY=""
OAUTH_STATE_SECRET=""

# ----------------------------------------------------------------------------
# Protected staging gate (HTTP Basic Auth over the whole app).
# Set STAGING_ACCESS_PASSWORD on staging/preview to require a password before
# anyone can reach the app during Instagram testing. Leave BLANK to disable
# (local dev / production with real user auth). STAGING_ACCESS_USER is optional.
# ----------------------------------------------------------------------------
STAGING_ACCESS_USER="staging"
STAGING_ACCESS_PASSWORD=""

# ----------------------------------------------------------------------------
# Instagram — "Instagram API with Instagram Login" (Unified Login), PCLM app.
# INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET : from the Meta app → Instagram product
#   ("Instagram app ID" / "Instagram app secret"). Required for the OAuth
#   consent flow that future customers use to connect their own accounts.
# META_GRAPH_VERSION : Graph API version (default v21.0).
#
# Exact OAuth redirect URI to register in the Meta app (Instagram → API setup
# with Instagram login → Business login settings → Redirect URLs):
#     ${APP_BASE_URL}/api/oauth/instagram/callback
#   e.g. https://your-staging-domain.vercel.app/api/oauth/instagram/callback
# ----------------------------------------------------------------------------
INSTAGRAM_APP_ID=""
INSTAGRAM_APP_SECRET=""
META_GRAPH_VERSION="v21.0"

# Optional overarching Meta app id/secret (only if you later use the Facebook
# Login path or /debug_token on graph.facebook.com). Not required for the
# Instagram Login flow above.
# META_APP_ID=""
# META_APP_SECRET=""

# ----------------------------------------------------------------------------
# Instagram TEST account (your authorised test account for read-only checks).
# These let the server verify a specific account WITHOUT the OAuth flow. The
# token is a long-lived Instagram access token; it is used server-side only and
# is never written to the database. Leave blank to require the OAuth flow.
#   INSTAGRAM_TEST_ACCOUNT_ID    : the Instagram Business account id (user_id)
#   INSTAGRAM_TEST_ACCESS_TOKEN  : long-lived access token (SECRET)
# ----------------------------------------------------------------------------
INSTAGRAM_TEST_ACCOUNT_ID=""
INSTAGRAM_TEST_ACCESS_TOKEN=""

# ----------------------------------------------------------------------------
# Media storage for generated graphics / carousels / video / uploads.
# STORAGE_DRIVER : "local" (served from /public/generated) or "vercel-blob".
# On Vercel the filesystem is ephemeral — use vercel-blob (requires the
# @vercel/blob package and a Blob store) so media persists and is CDN-served.
# ----------------------------------------------------------------------------
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
GENERATED_ASSETS_DIR="public/generated"

# ----------------------------------------------------------------------------
# Creative rendering (runs on the WORKER, not on Vercel Functions).
# ENABLE_VIDEO_RENDER : "0" forces the honest "render runtime unavailable"
#                       state instead of encoding video.
# ----------------------------------------------------------------------------
ENABLE_VIDEO_RENDER="1"

# ----------------------------------------------------------------------------
# Background worker + scheduler (separate always-on runtime; NOT Vercel).
# ----------------------------------------------------------------------------
WORKER_POLL_MS="2000"
SCHEDULER_TICK_MS="60000"
INTEGRATION_TIMEOUT_MS="12000"

# ----------------------------------------------------------------------------
# Email delivery (weekly reports). OPTIONAL — blank keeps the honest
# "not configured" state; nothing is faked when empty.
# ----------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# ----------------------------------------------------------------------------
# AI inference runtime (FUTURE / separate runtime). Ollama/worker-side only.
# Do NOT point this at personal subscription credentials. Leave unset to use
# the deterministic fallback path.
# ----------------------------------------------------------------------------
# AI_RUNTIME_URL=""
# AI_RUNTIME_KEY=""
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen3:8b"
