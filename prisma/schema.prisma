// ===========================================================================
// Organic Social OS — Prisma schema (SQLite testing environment)
//
// Design notes:
//  - SQLite via Prisma does not support native `enum` or the `Json` scalar.
//    Status/type fields are `String` with a fixed, documented set of allowed
//    values enforced in the typed data layer (src/lib/enums.ts + zod schemas).
//    Structured payloads are stored as JSON strings (parsed by src/lib/json.ts).
//  - Multi-tenancy: every tenant-scoped row carries an indexed `companyId`
//    with `onDelete: Cascade`. All data access goes through a company-scoped
//    repository (src/lib/tenant.ts) so cross-tenant reads are impossible.
//  - Global reference tables (ActivityCatalog, AgentDefinition) are seeded from
//    the Martech Meerkat automation register and are NOT tenant-scoped.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (used by the app + worker at runtime). On Vercel/Neon/
  // Supabase this is the pgbouncer/pooled URL.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection used only for `prisma migrate deploy`.
  // Falls back to DATABASE_URL when unset (see schema note / .env.example).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Users (minimal — the testing build operates multiple company workspaces)
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("owner") // owner | manager | viewer
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Company = tenant / workspace. The isolation boundary.
// ---------------------------------------------------------------------------
model Company {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  isDemo        Boolean  @default(false)
  dataLabel     String   @default("provided") // provided | illustrative_fixture
  status        String   @default("active")   // active | paused | archived

  // Brand Intelligence (Agent A)
  website       String?
  industry      String?
  markets       String?  // JSON string[]  (geos / segments)
  tagline       String?
  description   String?
  positioning   String?
  messaging     String?  // JSON { valueProps[], keyMessages[] }
  differentiators String? // JSON string[]  (what sets us apart)
  brandVoice    String?  // JSON { tone[], doList[], dontList[], writingGuidelines }
  icp           String?  // JSON { summary, firmographics, triggers, segments[] } (legacy primary; see IcpProfile)
  objectives    String?  // JSON string[]  (marketing objectives)
  audiencePriorities String? // JSON string[] (ordered audience priorities)
  logoUrl       String?
  colors        String?  // JSON { primary, secondary, accent, neutralDark, neutralLight }
  fonts         String?  // JSON { heading, body }
  timezone      String   @default("UTC")

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  config        CompanyConfig?
  documents     BrandDocument[]
  assets        BrandAsset[]
  personas      Persona[]
  competitors   Competitor[]
  claims        BrandClaim[]
  products      Product[]
  icpProfiles   IcpProfile[]
  knowledge     KnowledgeItem[]
  connections   PlatformConnection[]
  research      ResearchItem[]
  strategies    Strategy[]
  posts         ContentPost[]
  creatives     CreativeAsset[]
  analytics     AnalyticsDaily[]
  community     CommunityMessage[]
  reports       Report[]
  approvals     Approval[]
  tasks         Task[]
  logs          ExecutionLog[]
}

// ---------------------------------------------------------------------------
// Company configuration / automation controls (Section 5 + 14). 1:1 Company.
// ---------------------------------------------------------------------------
model CompanyConfig {
  id               String   @id @default(cuid())
  companyId        String   @unique
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  platforms        String   @default("[]") // JSON string[] active organic platforms
  postsPerDay      String   @default("{}") // JSON { [platform]: number }
  publishingDays   String   @default("[]") // JSON number[] (0=Sun..6=Sat)
  preferredTimes   String   @default("{}") // JSON { [platform]: ["09:00","13:00"] }
  timezone         String   @default("UTC")
  contentFormats   String   @default("[]") // JSON string[] allowed formats

  // Approval + autonomy
  approvalRequired Boolean  @default(true)
  autonomy         String   @default("{}") // JSON { [actionClass]: "A0".."A4" }
  autopublish      Boolean  @default(false)
  pausedWorkflows  String   @default("[]") // JSON string[] workflow keys paused

  // Weekly report delivery
  weeklyReportDay   Int      @default(1)      // 0=Sun..6=Sat
  weeklyReportTime  String   @default("08:00")
  reportRecipients  String   @default("[]")   // JSON string[] emails

  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Brand Intelligence (Agent A)
// ---------------------------------------------------------------------------
model BrandDocument {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  kind          String   @default("document") // document | guideline | website_page | note
  mimeType      String?
  sizeBytes     Int      @default(0)
  content       String?  // extracted text
  provenance    String?  // source url / upload origin
  // Document processing state: raw -> processed into KnowledgeItems (traceable).
  processed     Boolean  @default(false)
  createdAt     DateTime @default(now())

  knowledge     KnowledgeItem[]

  @@index([companyId])
}

model BrandAsset {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String   @default("logo") // logo | image | template | color | font
  name        String
  url         String?  // path under /public/generated or external
  meta        String?  // JSON
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model Persona {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  description String?
  demographics String? // JSON
  goals       String?  // JSON string[]  (objectives)
  painPoints  String?  // JSON string[]
  buyingMotivations String? // JSON string[]  (why they buy)
  channels    String?  // JSON string[]
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model Competitor {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  website     String?
  handles     String?  // JSON { [platform]: handle }
  notes       String?
  strengths   String?  // JSON string[]
  weaknesses  String?  // JSON string[]
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model BrandClaim {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind        String   @default("approved") // approved | prohibited
  text        String
  rationale   String?
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model Product {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  category    String?  // product | service
  description String?
  features    String?  // JSON string[]
  createdAt   DateTime @default(now())

  @@index([companyId])
}

// Multiple ICPs per company (Agent A). The legacy Company.icp JSON holds the
// primary summary for back-compat; IcpProfile is the editable, multi-ICP source.
model IcpProfile {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  summary       String?
  firmographics String?  // JSON string[]
  triggers      String?  // JSON string[]
  segments      String?  // JSON string[]
  priority      Int      @default(1)
  createdAt     DateTime @default(now())

  @@index([companyId])
}

// Deterministic, traceable knowledge extracted from BrandDocuments (no AI, no
// fabrication). Each item cites its source document.
model KnowledgeItem {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  sourceDocument   BrandDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  category         String   @default("fact") // fact | guideline | claim | product | other
  text             String
  createdAt        DateTime @default(now())

  @@index([companyId])
  @@index([sourceDocumentId])
}

// ---------------------------------------------------------------------------
// Connected Pages / Publishing connections (Agent F)
// ---------------------------------------------------------------------------
model PlatformConnection {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      String   // LINKEDIN | INSTAGRAM | FACEBOOK | YOUTUBE | TIKTOK
  handle        String?
  displayName   String?
  // NOTE: default is honest. A connection is only CONNECTED when a real
  // authorised credential/connector exists. No fabricated "connected" state.
  status        String   @default("not_connected") // not_connected | connected | blocked | unavailable
  capabilities  String?  // JSON detected capabilities (publish/schedule/analytics/inbox)
  connectedAt   DateTime?
  meta          String?  // JSON

  // --- Live provider identity (set ONLY after a verified authorisation) ------
  externalId     String?   // provider account id (e.g. Instagram Business account id)
  accountType    String?   // provider account type (e.g. BUSINESS | MEDIA_CREATOR)
  scopes         String?   // JSON string[] of granted permissions (as reported by the provider)
  // Where the credential came from. Governs demo vs live separation in the UI.
  //   none          — never connected
  //   env_test_token — a developer test token supplied via server env (not per-user)
  //   oauth          — a per-company token obtained through the OAuth consent flow
  dataSource     String    @default("none")
  // Encrypted access token at rest (AES-256-GCM). NEVER stored in plaintext and
  // NEVER sent to the browser. Only present for dataSource = "oauth".
  tokenCipher    String?
  tokenExpiresAt DateTime?
  lastVerifiedAt DateTime?
  lastError      String?   // last verification/connection error, surfaced honestly

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts      PublishAttempt[]

  @@unique([companyId, platform])
  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Research & Trends (Agent B)
// ---------------------------------------------------------------------------
model ResearchItem {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    String   // industry | trend | competitor | audience | news | opportunity
  title       String
  summary     String?
  body        String?
  confidence  String   @default("medium") // low | medium | high
  // How this record was produced — honesty flag surfaced in the UI.
  generatedBy String   @default("deterministic_generation") // deterministic_generation | imported | pending_runtime
  createdAt   DateTime @default(now())

  sources     ResearchSource[]

  @@index([companyId])
  @@index([companyId, category])
}

model ResearchSource {
  id             String       @id @default(cuid())
  researchItemId String
  item           ResearchItem @relation(fields: [researchItemId], references: [id], onDelete: Cascade)
  title          String
  url            String?
  publisher      String?
  publishedDate  String?
  retrievedDate  String?
  excerpt        String?

  @@index([researchItemId])
}

// ---------------------------------------------------------------------------
// Strategy & Calendar (Agent D)
// ---------------------------------------------------------------------------
model Strategy {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  period      String?  // e.g. "2026-W47" or "Q4 2026"
  summary     String?
  objectives  String?  // JSON string[]
  pillars     String?  // JSON [{ name, description, weight }]
  platformPlans String? // JSON { [platform]: { cadence, formats[], focus } }
  version     Int      @default(1)
  status      String   @default("active") // draft | active | superseded
  generatedBy String   @default("deterministic_generation")
  createdAt   DateTime @default(now())

  posts       ContentPost[]

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Content calendar entry / post (central). Agent D/E/F.
// ---------------------------------------------------------------------------
model ContentPost {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  strategyId          String?
  strategy            Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  platform            String   // LINKEDIN | INSTAGRAM | FACEBOOK | YOUTUBE | TIKTOK
  format              String   // static | carousel | reel | story | video | text | document | poll | short
  scheduledFor        DateTime
  slotIndex           Int      @default(0)

  topic               String
  targetAudience      String?
  objective           String?
  mainMessage         String?
  caption             String?
  hashtags            String?  // JSON string[]
  creativeRequirements String? // brief for creative production

  // Lifecycle status (drives the calendar + approvals + publishing queue)
  //  draft | processing | awaiting_approval | approved | scheduled |
  //  publishing | published | blocked | failed | unavailable | rejected
  status              String   @default("draft")

  // Accuracy gate: unchecked | passed | flagged | rejected
  validationStatus    String   @default("unchecked")
  validationNotes     String?  // JSON [{ severity, rule, message }]
  // Honest provenance of the copy: deterministic_generation | ai:<model>
  generatedBy         String   @default("deterministic_generation")

  sourcesJson         String?  // JSON [{ title, url }] supporting sources

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  creatives           CreativeAsset[]
  attempts            PublishAttempt[]
  metrics             PostMetric[]
  approvals           Approval[]

  @@index([companyId])
  @@index([companyId, scheduledFor])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Creative production (Agent E)
// ---------------------------------------------------------------------------
model CreativeAsset {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  postId          String?
  post            ContentPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  type            String   // static_graphic | carousel | video | image | story | reel | document | text
  title           String
  spec            String?  // JSON design spec (slides, copy, colors, layout)
  // capabilityState is honest: rendered means a real file exists on disk;
  // awaiting_render_runtime means the workflow is complete but the generation
  // capability (e.g. video encoder) is not available in this environment.
  capabilityState String   @default("draft") // draft | rendered | awaiting_render_runtime | blocked
  renderPath      String?  // path under /public/generated
  thumbnailPath   String?
  width           Int?
  height          Int?
  durationMs      Int?
  bytes           Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Publishing execution + verification (Agent F). Never fabricated.
// ---------------------------------------------------------------------------
model PublishAttempt {
  id             String   @id @default(cuid())
  companyId      String
  postId         String
  post           ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  connectionId   String?
  connection     PlatformConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  platform       String
  // queued | publishing | published | blocked | failed | duplicate_skipped
  status         String   @default("queued")
  externalId     String?  // ONLY set on a verified real publish
  externalUrl    String?  // ONLY set on a verified real publish
  verified       Boolean  @default(false)
  error          String?
  idempotencyKey String   @unique
  attemptedAt    DateTime @default(now())
  verifiedAt     DateTime?

  @@index([companyId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Performance Intelligence / Analytics (Agent C)
// ---------------------------------------------------------------------------
model AnalyticsDaily {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform      String
  date          DateTime
  followers     Int      @default(0)
  impressions   Int      @default(0)
  reach         Int      @default(0)
  engagements   Int      @default(0)
  profileVisits Int      @default(0)
  clicks        Int      @default(0)
  // Honest provenance of the numbers shown.
  source        String   @default("test_fixture") // test_fixture | imported | connected

  @@unique([companyId, platform, date])
  @@index([companyId])
}

model PostMetric {
  id           String   @id @default(cuid())
  companyId    String
  postId       String
  post         ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  impressions  Int      @default(0)
  reach        Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)
  saves        Int      @default(0)
  clicks       Int      @default(0)
  videoViews   Int      @default(0)
  retentionPct Float    @default(0)
  source       String   @default("test_fixture") // test_fixture | imported | connected
  collectedAt  DateTime @default(now())

  @@index([companyId])
  @@index([postId])
}

// ---------------------------------------------------------------------------
// Community Inbox (Agent F)
// ---------------------------------------------------------------------------
model CommunityMessage {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  platform    String
  kind        String   @default("comment") // comment | dm | mention
  author      String
  text        String
  sentiment   String?  // positive | neutral | negative
  status      String   @default("new") // new | drafted | replied | ignored
  replyDraft  String?
  source      String   @default("test_fixture") // test_fixture | connected
  receivedAt  DateTime @default(now())

  @@index([companyId])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Reporting & Optimisation (Agent G)
// ---------------------------------------------------------------------------
model Report {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  period        String   // e.g. "2026-W46"
  startDate     DateTime
  endDate       DateTime
  summary       String?  // JSON { headline, highlights[] }
  platformResults String? // JSON
  findings      String?  // JSON string[]
  recommendations String? // JSON string[]
  nextWeekPlan  String?  // JSON string[]
  dataBasis     String   @default("test_fixture") // test_fixture | imported | connected
  html          String?  // rendered report HTML
  status        String   @default("generated") // generated | delivered | failed
  generatedBy   String   @default("deterministic_generation")
  createdAt     DateTime @default(now())

  delivery      EmailDelivery?

  @@index([companyId])
}

model EmailDelivery {
  id               String   @id @default(cuid())
  companyId        String
  reportId         String   @unique
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  recipients       String   @default("[]") // JSON string[]
  // Honest delivery state. "not_configured" when no SMTP host is set.
  status           String   @default("not_configured") // not_configured | pending | sent | failed
  providerMessageId String?
  error            String?
  sentAt           DateTime?
  createdAt        DateTime @default(now())

  @@index([companyId])
}

// ---------------------------------------------------------------------------
// Approvals queue (Agent F / autonomy)
// ---------------------------------------------------------------------------
model Approval {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entityType  String   // post | creative | report
  postId      String?
  post        ContentPost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  entityId    String
  status      String   @default("pending") // pending | approved | rejected
  notes       String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([companyId, status])
}

// ---------------------------------------------------------------------------
// Task orchestration / durable job queue (background worker)
// ---------------------------------------------------------------------------
model Task {
  id             String   @id @default(cuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type           String   // workflow step key, e.g. research.run | strategy.build | creative.render | publish.execute | report.generate
  agentKey       String?  // owning specialist agent key
  agentSystem    String?  // A..G
  title          String
  status         String   @default("pending") // pending | processing | completed | blocked | failed | awaiting_approval | requires_runtime
  priority       Int      @default(5)
  payload        String?  // JSON input
  result         String?  // JSON output
  error          String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  idempotencyKey String?  @unique
  dependsOnId    String?
  dependsOn      Task?    @relation("TaskDeps", fields: [dependsOnId], references: [id], onDelete: SetNull)
  dependents     Task[]   @relation("TaskDeps")
  excelActivityRef String? // ActivityCatalog.excelId for traceability
  scheduledFor   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([companyId, status])
}

model ExecutionLog {
  id         String   @id @default(cuid())
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  taskId     String?
  level      String   @default("info") // info | warn | error
  agentKey   String?
  message    String
  data       String?  // JSON
  createdAt  DateTime @default(now())

  @@index([companyId])
  @@index([taskId])
}

// ===========================================================================
// GLOBAL REFERENCE DATA (seeded from the Martech Meerkat automation register)
// ===========================================================================

model ActivityCatalog {
  id              String  @id @default(cuid())
  excelId         String  @unique // e.g. MM-0345 (preserved original ID)
  sourceParagraph String?
  itemType        String?
  domain          String
  workstream      String
  track           String?
  activity        String
  assignedAgent   String
  executionMode   String?
  trigger         String?
  integrations    String?
  output          String?
  kpi             String?
  guardrail       String?
  releaseWave     String?
  scope           String  // organic | paid | leadgen
  agentSystem     String? // A..G (mapped to the 7 agent systems)
  // Implementation traceability — updated as features land + tests pass.
  implementationStatus String @default("planned") // planned | partial | implemented | deferred
  implementedIn   String?  // feature/route reference
  testEvidence    String?  // test id / artifact reference

  @@index([domain])
  @@index([scope])
  @@index([agentSystem])
  @@index([assignedAgent])
}

model AgentDefinition {
  key            String  @id // stable key, e.g. social_analytics
  name           String  @unique
  agentSystem    String  // A..G
  summary        String
  domains        String? // JSON string[]
  responsibilities String? // JSON string[]
  activityCount  Int     @default(0)
  scope          String  @default("organic")
}
